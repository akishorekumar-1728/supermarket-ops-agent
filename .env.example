# Telegram Bot Token (from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Keys — comma-separated list (no spaces around commas)
# Get free keys at: https://aistudio.google.com/
# Add as many keys as you want; the bot auto-rotates when quota is exceeded.
GEMINI_API_KEYS=your_gemini_key_1,your_gemini_key_2,your_gemini_key_3

# Optional: Gemini model name (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Optional: SQLite database path (default: data/supermarket.db)
# DB_PATH=data/supermarket.db
